)
STORED AS ORC;

-- 2) 装数：拆 -> 关联(unfixed=0) -> 聚合回拼
INSERT OVERWRITE TABLE tmp_jwh_github_purl_versions_unfixed0
SELECT
  g.md5_purl_version,
  g.purl,
  g.version,
  CASE
    WHEN size(g.cve_set) > 0
      THEN concat_ws(';', sort_array(g.cve_set))
    ELSE NULL
  END AS cves
FROM (
  SELECT
    j.md5_purl_version,
    j.purl,
    j.version,
    collect_set(j.cve_num) AS cve_set
  FROM (
    SELECT
      e.md5_purl_version,
      e.purl,
      e.version,
      s.cve_num                      -- 仅当 unfixed=0 匹配成功才有值
    FROM (
      SELECT
        v.md5_purl_version,          -- ⚠ 若你的源表列名是 md5sum_of_purl，请把此处及下方统一替换
        v.purl,
        v.version,
        upper(trim(cve)) AS cve
      FROM tmp_jwh_github_purl_versions v
      LATERAL VIEW OUTER explode(
        split(coalesce(v.cves, ''), '\\s*;\\s*')
      ) e AS cve
    ) e
    LEFT JOIN tmp_jwh_cve_unfixed_status s
      ON e.cve = upper(s.cve_num)
     AND s.unfixed = 0
  ) j
  GROUP BY j.md5_purl_version, j.purl, j.version
) g;





