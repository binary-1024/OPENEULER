DROP TABLE IF EXISTS tmp_jwh_github_purl_versions_unfixed0;
CREATE TABLE tmp_jwh_github_purl_versions_unfixed0 AS
WITH exploded AS (          -- ① 先把 ; 分隔的 cves 拆成多行
  SELECT
    v.md5_purl_version,
    v.purl,
    v.version,
    upper(trim(cve)) AS cve
  FROM tmp_jwh_github_purl_versions v
  LATERAL VIEW OUTER explode(
    split(COALESCE(v.cves, ''), '\\s*;\\s*')
  ) e AS cve
),
joined AS (                 -- ② 再与状态表关联，仅保留 unfixed = 0
  SELECT
    e.md5_purl_version,
    e.purl,
    e.version,
    s.cve_num               -- 匹配成功则有值；否则为 NULL
  FROM exploded e
  LEFT JOIN tmp_jwh_cve_unfixed_status s
    ON e.cve = upper(s.cve_num)
   AND s.unfixed = 0
)
-- ③ 最后按组件版本聚合，去重排序后用 ; 拼回
SELECT
  md5_purl_version,
  purl,
  version,
  CASE
    WHEN size(collect_set(cve_num)) > 0
