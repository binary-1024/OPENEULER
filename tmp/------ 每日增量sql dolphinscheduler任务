DROP TABLE IF EXISTS tmp_jwh_github_purl_versions;
CREATE TABLE tmp_jwh_github_purl_versions AS
WITH a AS (
  SELECT DISTINCT
    md5sum_of_purl,
    purl,
    version
  FROM dws.dws_vul_cve_purl_new
  -- WHERE lower(regexp_extract(purl,'^pkg:([^/]+)',1)) = 'github'     -- 从 purl 提取生态
),
b AS (
  SELECT
    md5sum_of_purl,
    cve,
    purl,
    version
  FROM dws.dws_vul_cve_purl_new
  WHERE cve RLIKE '^CVE-'                                           -- 更鲁棒
    AND version NOT RLIKE '^(>=|<=|<)\\s?'                          -- 更鲁棒
    AND purl IS NOT NULL
    AND version IS NOT NULL
)
SELECT
  a.md5sum_of_purl          AS md5_purl_version,
  a.purl,
  a.version,
  concat_ws(';', sort_array(collect_set(b.cve))) AS cves
FROM a
JOIN b
  ON a.md5sum_of_purl = b.md5sum_of_purl
GROUP BY
  a.md5sum_of_purl, a.purl, a.version;

 
