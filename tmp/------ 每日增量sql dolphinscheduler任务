)
STORED AS ORC;


CREATE TABLE cve_unfixed_status AS
SELECT
    cve_num,
    CASE
        WHEN 
            ( (patch IS NULL OR TRIM(patch) = '' OR patch = '[]') AND
              (workaround IS NULL OR TRIM(workaround) = '' OR workaround = '[]') AND
              (cnnvd_patches IS NULL OR TRIM(cnnvd_patches) = '' OR cnnvd_patches = '[]') AND
              (fix_version IS NULL OR TRIM(fix_version) = '' OR fix_version = '[]') )
        THEN 0
        ELSE 1
    END AS unfixed
FROM vulnerability_knowledge;

