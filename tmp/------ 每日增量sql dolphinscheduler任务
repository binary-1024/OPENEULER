-- 1) 先建结果表（按需改存储格式）
DROP TABLE IF EXISTS tmp_jwh_github_purl_versions_unfixed0;
CREATE TABLE tmp_jwh_github_purl_versions_unfixed0 (
  md5_purl_version STRING,
